# Local deployment settings. Copy to deploy/.env.local and keep it out of git.
AWS_PROFILE=final-project
AWS_REGION=eu-west-1
STACK_NAME=lobechat-final
PROJECT_NAME=lobechat-final
INSTANCE_TYPE=t3a.xlarge
ROOT_VOLUME_SIZE=80
ACME_EMAIL=your-email@example.com

# Use secretsmanager when the AWS role permits it. The course sandbox currently
# denies both Secrets Manager and SSM writes, so local keeps runtime secrets in
# deploy/local/ and copies the rendered .env over SSH.
SECRET_BACKEND=local

# Required. Store a freshly rotated key here before deployment.
OPENROUTER_API_KEY=

# Optional direct OpenAI provider. Recommended for reliable MCP tool calling.
OPENAI_API_KEY=

# Optional. Leave blank when the Notion MCP server is not needed.
OPENAPI_MCP_HEADERS=
